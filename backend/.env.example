# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================
PORT=5000
NODE_ENV=development

# ==============================================================================
# DATABASE (PostgreSQL / Prisma)
# ==============================================================================
DATABASE_URL="postgresql://user:password@localhost:5432/raffu?schema=public"

# ==============================================================================
# APPLICATION URLS & CORS
# (Used for emails, redirects, admin setup, and CORS origin whitelisting)
# ==============================================================================
FRONTEND_URL=http://localhost:3000
STUDIO_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002
# Optional additional CORS origins (comma-separated):
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ==============================================================================
# COOKIES & DOMAIN SCOPING (Production)
# Set to shared root/wildcard domain (e.g. .yourdomain.com) when deploying across subdomains
# Leave empty for localhost development
# ==============================================================================
COOKIE_DOMAIN=

# ==============================================================================
# AUTHENTICATION & JWT SECRETS
# Generate strong 32+ character random secrets (e.g. using openssl rand -base64 32)
# ==============================================================================
JWT_SECRET=your-secure-random-jwt-secret-key
JWT_REFRESH_SECRET=your-secure-random-jwt-refresh-secret-key

# ==============================================================================
# GOOGLE OAUTH CREDENTIALS (Required for Google Login / Signup)
# ==============================================================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ==============================================================================
# AWS SNS (SMS OTP Verification)
# ==============================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# ==============================================================================
# RESEND (Email OTP & Notifications)
# ==============================================================================
RESEND_API_KEY=your-resend-api-key
DEFAULT_FROM_EMAIL=Raffu <no-reply@yourdomain.com>

# =
# GOOGLE ROUTES API (Road distance for order dispatch)
# Server-side key with the "Routes API" enabled. Restrict it to your server IP; never reuse the
# frontend Maps key. If unset, dispatch falls back to straight-line distance.
# =
GOOGLE_ROUTES_API_KEY=
# Travel mode for road distance: DRIVE (default), TWO_WHEELER, WALK, BICYCLE
ROUTES_TRAVEL_MODE=

# =
# STUDIO VERIFICATION UPLOADS (local disk)
# Folder for shop photos / machine videos. Defaults to backend/uploads. Must be persistent storage.
# FILE_SIGNING_SECRET signs the expiring links the admin console uses to view files (defaults to JWT_SECRET).
# =
UPLOADS_DIR=
FILE_SIGNING_SECRET=
