// Prisma Schema for Raffu Backend
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String   @id @default(cuid())
  name       String
  email      String?  @unique
  contact    String?
  phone      String?  @unique
  avatar     String?
  address    String?
  postcode   String?
  method     String   @default("email") // google, email, mobile, apple
  password   String?
  role       String   @default("CUSTOMER") // CUSTOMER, TEMP_STUDIO, STUDIO, ADMIN
  status     String   @default("ACTIVE") // ACTIVE, INACTIVE
  studioId   String?
  studioName String?
  currency   String   @default("GBP")
  currencySymbol String @default("£")
  measurements String?
  refreshToken String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orders Order[]
  pushSubscriptions PushSubscription[]

  @@index([email])
  @@index([phone])
  @@map("users")
}

model OtpVerification {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
  @@map("otp_verifications")
}

model GarmentCategory {
  id            String   @id
  name          String
  tagline       String?
  startingPrice Float
  avgTurnaround String   @default("48 hours")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  services AlterationService[]

  @@map("garment_categories")
}

model AlterationService {
  id             String          @id
  categoryId     String
  category       GarmentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  customerPrice  Float
  partnerPayout  Float
  platformFee    Float
  turnaroundDays Int             @default(2)
  popular        Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([categoryId])
  @@map("alteration_services")
}

model PartnerStore {
  id            String   @id
  name          String
  email         String?
  phone         String?
  area          String
  address       String
  postcode      String
  rating        Float    @default(4.9)
  reviewCount   Int      @default(100)
  openingHours  String   @default("09:00 - 19:00")
  dailyCapacity Int      @default(25)
  machines      Int      @default(6)
  workers       Int      @default(4)
  leadTailor    String
  specialties   String[]
  retailSold    Boolean  @default(true)
  currency      String   @default("GBP")
  currencySymbol String  @default("£")
  status        String   @default("ACTIVE") // ACTIVE, INACTIVE
  lat           Float
  lng           Float
  distance      String?
  distanceMiles Float?
  verificationStatus String    @default("UNSUBMITTED") // UNSUBMITTED, PENDING, APPROVED, REJECTED
  verifiedAt         DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders Order[]
  pushSubscriptions PushSubscription[]
  verifications StudioVerification[]

  @@index([verificationStatus])
  @@index([area])
  @@index([postcode])
  @@index([email])
  @@index([phone])
  @@index([status])
  @@map("partner_stores")
}

model Order {
  id                    String        @id
  userId                String?
  user                  User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName          String
  customerEmail         String
  customerPhone         String?
  postcode              String
  garmentId             String
  garmentName           String
  quantity              Int           @default(1)
  serviceId             String
  serviceName           String
  storeId               String?
  store                 PartnerStore? @relation(fields: [storeId], references: [id], onDelete: SetNull)
  storeName             String?
  storePhone            String?
  date                  String
  timeSlot              String
  garmentBrand          String?
  fitNotes              String?
  pinnedAdjustment      String?
  sewingNotes           String?
  slaHours              Int           @default(48)
  partnerPayout         Float         @default(18.0)
  retailSold            Boolean       @default(false)
  retailValue           Float?
  retailCategory        String?
  assignedWorker        String?
  machineNo             String?
  hangTagNo             String?
  intakePhotoUrl        String?
  fabricConditionNotes  String?
  priceAdjustment       Float?
  priceAdjustmentReason String?
  priceAdjustmentStatus String        @default("NONE") // NONE, PENDING_APPROVAL, APPROVED, DECLINED
  slaStartedAt          DateTime?
  rating                Float?
  ratingFeedback        String?
  customerLat           Float?
  customerLng           Float?
  tailorLat             Float?
  tailorLng             Float?
  status                String        @default("Allocated") // Allocated, Accepted, Customer Arrived, Fitting Completed, Work in Progress, Ready, Collected, Closed
  price                 Float
  currency              String        @default("GBP")
  currencySymbol        String        @default("£")
  otp                   String
  otpExpiresAt          DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([userId])
  @@index([customerEmail])
  @@index([customerPhone])
  @@index([storeId])
  @@index([status])
  @@map("orders")
}

model NewsletterSubscription {
  id        String   @id @default(cuid())
  email     String   @unique
  status    String   @default("ACTIVE") // ACTIVE, UNSUBSCRIBED
  source    String   @default("footer")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@map("newsletter_subscriptions")
}

model StudioCatalogItem {
  id             String   @id @default(cuid())
  studioId       String
  userId         String?
  categoryId     String
  categoryName   String
  serviceId      String?
  name           String
  description    String?
  price          Float
  currency       String   @default("GBP")
  currencySymbol String   @default("£")
  partnerPayout  Float?
  turnaroundDays Int      @default(2)
  avgTurnaround  String   @default("48 hours")
  enabled        Boolean  @default(true)
  isCustom       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([studioId])
  @@index([userId])
  @@index([categoryId])
  @@map("studio_catalog_items")
}

model ContactInquiry {
  id          String   @id @default(cuid())
  name        String
  email       String?
  phone       String?
  topic       String?
  category    String?
  orderNumber String?
  message     String
  source      String   @default("Client Concierge Desk")
  priority    String   @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  status      String   @default("NEW")    // NEW, IN_REVIEW, RESOLVED, ARCHIVED
  adminNotes  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([source])
  @@index([createdAt])
  @@index([email])
  @@index([phone])
  @@map("contact_inquiries")
}

model PushSubscription {
  id         String        @id @default(cuid())
  endpoint   String        @unique
  p256dh     String
  auth       String
  storeId    String?
  store      PartnerStore? @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([storeId])
  @@index([userId])
  @@map("push_subscriptions")
}



// Live order dispatch search, shared by every backend instance and kept across restarts.
// Stage progression is driven by timestamps (no in-process timers); every write bumps `version`
// and is applied only if `version` is unchanged, so concurrent instances never clobber each other.
model DispatchSession {
  orderId                  String    @id
  status                   String // SEARCHING, ACCEPTING, ASSIGNED, EXHAUSTED, ZERO_TAILORS, CANCELLED, SCHEDULED
  version                  Int       @default(0)
  stage                    Int       @default(1)
  currentRadius            Float     @default(1)
  startedAt                DateTime
  stageStartedAt           DateTime
  stageEndsAt              DateTime
  hardTimeoutAt            DateTime
  expiresAt                DateTime
  orderData                Json
  customerLat              Float
  customerLng              Float
  tailorPool               Json
  totalEligibleCount       Int       @default(0)
  // Lower-cased studio ids
  declinedTailorIds        String[]  @default([])
  activeCandidateTailorIds String[]  @default([])
  acceptedTailorId         String?
  acceptedTailor           Json?
  confirmedOrder           Json?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([status, stageEndsAt])
  @@index([expiresAt])
  @@index([activeCandidateTailorIds], type: Gin)
  @@map("dispatch_sessions")
}

// One-time studio verification submission. Files live on local disk under uploads/verifications;
// the columns hold paths relative to the uploads root. Rejected studios resubmit as a new row.
model StudioVerification {
  id              String       @id @default(cuid())
  storeId         String
  store           PartnerStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  shopFrontImage  String
  interiorImage   String
  machinesVideo   String
  status          String       @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([storeId])
  @@index([status])
  @@map("studio_verifications")
}
