{
  "name": "Raffu-backend",
  "version": "1.0.0",
  "description": "Backend API service for Raffu on-demand alterations",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "postinstall": "prisma generate",
    "dev": "node --watch-path=server.js --watch-path=routes --watch-path=services --watch-path=lib --watch-path=prisma server.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "admin:create": "node scripts/create-super-admin.js",
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-sns": "^3.1138.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "pg": "^8.23.0",
    "resend": "^6.32.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "prisma": "^7.10.0"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/client@7.10.0": true,
    "@prisma/engines@7.10.0": true
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.22.0"
  }
}
